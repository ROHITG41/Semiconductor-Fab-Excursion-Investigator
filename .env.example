# Copy to .env (never commit .env). Leave GEMINI_API_KEY empty to use Scripted offline / Replay modes only.
GEMINI_API_KEY=
# Optional overrides (defaults are in config.py)
# FAST_LOOP_MODEL=gemini-3.5-flash-lite
# REASONING_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-2
# MAX_AGENT_STEPS=8
# LLM_TEMPERATURE=0

# Required for human sign-off (audit chain). Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
FAB_SENTRY_HMAC_SECRET=
# Optional: use offline hashing embeddings instead of Gemini for the knowledge base
# FAB_SENTRY_EMBEDDER=offline

# Set to 1 only on a shared public deployment: hides Live Gemini and sign-off, uses demo_traces/
# FAB_SENTRY_PUBLIC_DEMO=0
